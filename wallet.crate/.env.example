INFURA_KEY=USE_INFURA_API_KEY_HERE
INFURA_HTTPS=https://mainnet.infura.io/v3/INFURA_API_KEY_HERE
ALCHEMY_KEY=USE_ALCHEMY_API_KEY_HERE
ALCHEMY_HTTPS=https://eth-mainnet.g.alchemy.com/v2/ALCHEMY_API_KEY_HERE
ANKR_KEY=USE_ANKR_API_KEY_HERE
# Ethereum Mainnet
PUBLIC_RPCS_MAINNET=https://rpc.ankr.com/eth/${ANKR_KEY},https://rpc.flashbots.net,https://cloudflare-eth.com
# Sepolia
PUBLIC_RPCS_SEPOLIA=https://rpc.ankr.com/eth_sepolia/${ANKR_KEY},https://ethereum-sepolia.publicnode.com
# Goerli
PUBLIC_RPCS_GOERLI=https://rpc.ankr.com/eth_goerli/${ANKR_KEY},https://ethereum-goerli.publicnode.com
# BNB
PUBLIC_RPCS_BNB=https://rpc.ankr.com/bsc/${ANKR_KEY},https://bsc-dataseed.binance.org
# Polygon
PUBLIC_RPCS_POLYGON=https://polygon-rpc.com
PUBLIC_BASE=http://localhost:7878
BIND=0.0.0.0:7878
RATE_LIMIT_PER_MINUTE=120 #integer
# Enable dev-only upstreams inspection
EXPOSE_UPSTREAMS=1 #integer
# Round-robin rotation enabled for upstreams
RR_ENABLED=true #boolean true/false
# Circuit breaker cooldown in seconds
CB_COOLDOWN_SECS=45 #integer
# Cache TTL for eth_chainId (seconds)
CACHE_CHAINID_TTL=30 #integer
